# Backend API URL
# NEXT_PUBLIC_API_URL=https://your-api.example.com
NEXT_PUBLIC_API_URL=https://proactive-creativity-production.up.railway.app

# API Key for authenticated backend endpoints (must match COOLEDAI_API_KEY in backend .env)
# Generate with: openssl rand -hex 16
NEXT_PUBLIC_COOLEDAI_API_KEY=

# Clerk authentication (optional — site runs in Demo Mode without Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Demo Mode portal credentials (override in production or disable demo)
NEXT_PUBLIC_DEMO_USER=demo
NEXT_PUBLIC_DEMO_PASS=cooledai2026

# Lemon Squeezy (billing) — Lemon.js checkout overlay
NEXT_PUBLIC_VARIANT_ID=your-variant-id
# Optional: override checkout domain (default: billing.cooledai.com)
# NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_DOMAIN=billing.cooledai.com
# Optional: override success redirect (default: https://www.cooledai.com/portal?success=true)
# NEXT_PUBLIC_CHECKOUT_SUCCESS_REDIRECT_URL=https://www.cooledai.com/portal?success=true

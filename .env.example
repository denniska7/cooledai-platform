# =============================================================================
# CooledAI Simulator — Environment Variables
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Or auto-generate keys:
#   ./setup_env.sh
#
# NEVER commit .env to version control.
# =============================================================================


# ─── Environment Mode ────────────────────────────────────────────────
# "dev" | "development" | "local" = localhost CORS, no HSTS
# "production" (default)          = strict CORS, HSTS enabled
COOLEDAI_ENV=dev


# ─── Server ──────────────────────────────────────────────────────────
# HOST=127.0.0.1 for local dev, 0.0.0.0 for containers
HOST=127.0.0.1
PORT=8000


# ─── API Authentication ──────────────────────────────────────────────
# Required for control endpoints (POST /optimize, /state, /apply,
# /ingest/*, /api/v1/telemetry).
# Generate with: openssl rand -hex 32
COOLEDAI_API_KEY=your_api_key_here

# Admin key for privileged endpoints (/admin/*, /shadow, /test-email,
# /discovery/clear). Falls back to COOLEDAI_API_KEY if not set.
COOLEDAI_ADMIN_KEY=your_admin_key_here


# ─── CORS (optional override) ────────────────────────────────────────
# Comma-separated origins. Leave empty for defaults (cooledai.com).
# In dev mode, localhost:3000 is added automatically.
# CORS_ORIGINS=


# ─── Database Paths ──────────────────────────────────────────────────
# Baseline reporter database (default: data/baseline.db)
# COOLEDAI_BASELINE_DB=data/baseline.db


# ─── Financial & Utility Rates ───────────────────────────────────────
# Used by ROI calculator, baseline reporter, and shadow-mode savings.
COOLEDAI_UTILITY_RATE=0.12
COOLEDAI_CO2_KG_PER_KWH=0.4
COOLEDAI_REBATE_PER_KWH=0.05
COOLEDAI_PROJECTED_PUE_IMPROVEMENT_PCT=12

# Minimum $/hr savings to log as "Missed Opportunity" in shadow mode
COOLEDAI_MISSED_OPPORTUNITY_THRESHOLD_USD=10


# ─── AI / LLM (Briefing Agent, Discovery Agent) ─────────────────────
# At least one key required for Morning Briefing and Discovery Agent.
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model for LLM calls
COOLEDAI_LLM_MODEL=gpt-4o-mini


# ─── Email (Lead Capture, Beta Signup via Resend) ────────────────────
RESEND_API_KEY=your_resend_key_here
LEAD_EMAIL_FROM=CooledAI <onboarding@resend.dev>
LEAD_EMAIL_TO=you@example.com


# ─── Gateway / Edge Agent ────────────────────────────────────────────
# Backend API URL for telemetry push
COOLEDAI_BACKEND_URL=http://localhost:8000

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL_SEC=10

# Seconds before reverting to fail-safe on cloud loss
COOLEDAI_CLOUD_LOSS_TIMEOUT_SEC=30

# Unique agent identifier (appears in telemetry payloads)
COOLEDAI_AGENT_ID=default

# Control mode: SHADOW (log only) or ACTIVE (send commands to hardware)
CONTROL_MODE=SHADOW


# ─── Watchdog Sidecar ────────────────────────────────────────────────
# Standalone process that monitors API health and forces fail-safe
# cooling via Redfish if the API is unreachable.
COOLEDAI_API_URL=http://localhost:8000
COOLEDAI_HEALTH_PATH=/health
COOLEDAI_API_TIMEOUT=30
COOLEDAI_FAIL_SAFE_PCT=70
COOLEDAI_VERIFY_SSL=true


# ─── Redfish (BMC / Server Hardware) ─────────────────────────────────
# Comma-separated Redfish base URLs for fail-safe and discovery
COOLEDAI_REDFISH_URLS=https://192.168.1.10
COOLEDAI_REDFISH_USER=your_redfish_user_here
COOLEDAI_REDFISH_PASS=your_redfish_pass_here


# ─── Slurm / HPC Integration ─────────────────────────────────────────
# GPU partition names for job observer pre-cooling (comma-separated)
# COOLEDAI_GPU_PARTITIONS=gpu,a100


# ─── Frontend (set in frontend/.env.local, not here) ─────────────────
# See frontend/.env.example for the full list. Key variables:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   NEXT_PUBLIC_COOLEDAI_API_KEY=<same as COOLEDAI_API_KEY above>
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
#   NEXT_PUBLIC_DEMO_USER=demo
#   NEXT_PUBLIC_DEMO_PASS=cooledai2026
#   NEXT_PUBLIC_VARIANT_ID=<lemon squeezy variant>
#   NEXT_PUBLIC_FORMSPREE_FORM_ID=<formspree id>
#   NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_DOMAIN=billing.cooledai.com

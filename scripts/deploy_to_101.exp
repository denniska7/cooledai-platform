#!/usr/bin/expect -f
# Deploy and start telemetry on .101 (ST550-Shadow-Node)
# Usage: cd /path/to/coolingai_simulator && expect scripts/deploy_to_101.exp

set timeout 180
set pass "<SSH_PASSWORD>"
set host "cooledaiadmin@192.168.12.101"
set send_delay 10
set script_dir [file dirname [info script]]
set project_root [file dirname $script_dir]

spawn scp -o StrictHostKeyChecking=no $project_root/scripts/st550_telemetry.py $project_root/scripts/start_telemetry.sh $host:~/
expect "password:"
sleep $send_delay
send "$pass\r"
expect eof

spawn scp -o StrictHostKeyChecking=no $project_root/scripts/llama_workload_scheduler.py $host:~/
expect "password:"
sleep $send_delay
send "$pass\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $host
expect "password:"
sleep $send_delay
send "$pass\r"
expect -re {\$ |# }
send "sudo apt-get update -qq && sudo apt-get install -y -qq python3-pynvml 2>/dev/null; sudo apt-get install -y -qq python3-pip 2>/dev/null; sudo python3 -m pip install --break-system-packages -q nvidia-ml-py3 requests psutil 2>/dev/null; echo deps_done\r"
expect {
    "password for" { sleep $send_delay; send "$pass\r"; exp_continue }
    -re {\$ |# } { }
}
expect -re {\$ |# }
send "sudo bash ~/start_telemetry.sh --node-id ST550-Control-Traditional\r"
expect {
    "password for" { sleep $send_delay; send "$pass\r"; exp_continue }
    -re {\$ |# } { }
    timeout { puts "Timeout"; exit 1 }
}
expect -re {\$ |# }
send "pkill -f workload_sim.py 2>/dev/null || true; pkill -f llama_workload_scheduler.py 2>/dev/null || true; pkill -f predictive_engine.py 2>/dev/null || true\r"
expect -re {\$ |# }
send "nohup python3 ~/llama_workload_scheduler.py > /tmp/cooledai_llama_workload.log 2>&1 &\r"
expect -re {\$ |# }
send "sleep 12 && tail -30 /var/log/cooledai_telemetry.log 2>/dev/null || tail -30 /tmp/cooledai_telemetry.log\r"
expect -re {\$ |# }
send "exit\r"
expect eof

#!/usr/bin/expect -f
set timeout 60
set pass "<SSH_PASSWORD>"
spawn ssh -o StrictHostKeyChecking=no cooledaiadmin@100.92.29.44
expect "password:" { send "$pass\r" }
expect -re {\$ }

# Write a deploy script to /tmp, then sudo run it
send "cat > /tmp/do_deploy.sh << 'EOF'\n"
send "#!/bin/bash\n"
send "cp /tmp/cooledai_agent.py /opt/cooledai/cooledai_agent.py\n"
send "rm -f /var/lib/cooledai/calibration_profile.json\n"
send "systemctl restart cooledai-agent\n"
send "echo DEPLOY_SUCCESS\n"
send "EOF\n"
expect -re {\$ }
sleep 1

send "chmod +x /tmp/do_deploy.sh\r"
expect -re {\$ }

send "sudo /tmp/do_deploy.sh\r"
expect {
    "password for" { send "$pass\r"; exp_continue }
    "DEPLOY_SUCCESS" { puts "\n>>> Deploy successful!" }
    timeout { puts "\n>>> TIMEOUT" }
}
expect -re {\$ }
sleep 1

# Verify
send "ls -la /opt/cooledai/cooledai_agent.py\r"
expect -re {\$ }
sleep 1

send "ls /var/lib/cooledai/calibration_profile.json 2>&1\r"
expect -re {\$ }
sleep 1

send "exit\r"
expect eof

#!/usr/bin/expect -f
set timeout 60
set pass "***REDACTED_SSH_PASS***"
spawn ssh -o StrictHostKeyChecking=no cooledaiadmin@100.92.29.44
expect "password:" { send "$pass\r" }
expect -re {\$ }

# Check if calibration completed
send "sudo journalctl -u cooledai-agent --since '35 minutes ago' --no-pager 2>&1 | grep -E 'calibration complete|idle_samples|active_samples|Saved calibration' | tail -5\r"
expect {
    "password for" { send "$pass\r"; exp_continue }
    -re {\$ } { }
}
sleep 2

# Check calibration profile
send "cat /var/lib/cooledai/calibration_profile.json 2>&1\r"
expect -re {\$ }
sleep 1

# Last 5 FAN_DIAG
send "sudo journalctl -u cooledai-agent --since '1 minute ago' --no-pager 2>&1 | grep FAN_DIAG | tail -5\r"
expect -re {\$ }
sleep 1

# Idle stepping count
send "sudo journalctl -u cooledai-agent --since '35 minutes ago' --no-pager 2>&1 | grep -c 'calibration_idle_step'\r"
expect -re {\$ }
sleep 1

# Duty variation — unique duties
send "sudo journalctl -u cooledai-agent --since '5 minutes ago' --no-pager 2>&1 | grep FAN_DIAG | sed 's/.*target_duty=\\([0-9]*\\)%.*/\\1/' | sort -u\r"
expect -re {\$ }
sleep 1

send "exit\r"
expect eof

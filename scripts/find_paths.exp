#!/usr/bin/expect -f
set timeout 30
set pass "***REDACTED_SSH_PASS***"
spawn ssh -o StrictHostKeyChecking=no cooledaiadmin@100.92.29.44
expect "password:" { send "$pass\r" }
expect -re {\$ }

send "sudo find /opt/cooledai -name 'optimizer.py' -o -name 'cooledai_agent.py' 2>&1\r"
expect {
    "password for" { send "$pass\r"; exp_continue }
    -re {\$ } { }
}
sleep 1

send "sudo find /opt/cooledai -type d 2>&1 | head -20\r"
expect -re {\$ }
sleep 1

# Also check systemd service to see where the agent binary actually lives
send "sudo cat /etc/systemd/system/cooledai-agent.service 2>&1\r"
expect -re {\$ }
sleep 1

send "sudo cat /var/lib/cooledai/calibration_profile.json 2>&1\r"
expect -re {\$ }
sleep 1

send "exit\r"
expect eof
